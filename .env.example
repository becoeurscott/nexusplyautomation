# --- Database ---
# Neon Postgres — get from https://console.neon.tech
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Auth (Better-Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-plus-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Encryption (for stored provider API keys) ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-base64

# --- Zernio ---
ZERNIO_API_BASE=https://zernio.com/api/v1
# Platform-level key — operator-only, never shown to customers. Every org is
# a Zernio "profile" under this one account.
ZERNIO_API_KEY=

# Optional dev fallback if an org hasn't set their own key yet

# --- CloneViral ---
CLONEVIRAL_API_BASE=https://api.cloneviral.com/v1
CLONEVIRAL_API_KEY=

# Claude for hard tasks (calendar, scripts, replies, caption gen)
# Gemini Flash for cheap tasks (caption polish, translation, summarization)

# --- Background jobs (Inngest) ---
# Local dev: run `npx inngest-cli@latest dev` — no keys needed
# Production: set from https://app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Payments (Africa-first) ---
# Flutterwave — primary African rail (cards + MoMo pan-African)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# IntaSend — KE M-Pesa STK Push (Phase B2)
INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=
# Paystack — NG/GH/ZA cards + bank (Phase B2)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Lemon Squeezy — Merchant-of-Record for USD international (Agency tier, later)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Media storage (UploadThing) ---
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Nexusply <hello@nexusply.ai>

# --- Sevalla (deploy target) ---
SEVALLA_API_KEY=
SEVALLA_DB_ID=
SEVALLA_CLUSTER_ID=20204189-9832-46a5-b281-c3dc18dbe2a4

# --- Admin dashboard (operator-only, not linked from the app) ---
ADMIN_EMAILS=

# --- AI (OpenRouter serves every model; no other LLM vendor) ---
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Any slug from https://openrouter.ai/models
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-5
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
OPENROUTER_MODEL_IMAGE=google/gemini-2.5-flash-image

# --- TikTok direct OAuth (src/lib/oauth) — independent of Zernio ---
# From TikTok for Developers, once the app is registered and audited.
# See the plan: unaudited apps can still connect and test, but posts
# are restricted to self-only visibility until the audit clears.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
